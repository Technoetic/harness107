# Keep this policy file stable so fresh Windows worktrees read the same bytes.
.gitattributes text eol=lf

# Shell scripts: LF only (CRLF breaks bash execution on macOS/Linux)
*.sh text eol=lf

# PowerShell: native EOL (CRLF on Windows is fine)
*.ps1 text

# JSON / markdown: LF for cross-platform stability
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
